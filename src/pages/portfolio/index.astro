---
import { getCollection } from "astro:content";
import MainGridLayout from "@layouts/MainGridLayout.astro";

const entries = await getCollection("projects");
entries.sort((a, b) => a.data.order - b.data.order);
---

<MainGridLayout title="作品集" description="蒋继庆（erode）的能力作品集：独立负责的项目、可验证的成果与可持续沉淀的方法论资产">
	<div class="flex w-full rounded-[var(--radius-large)] overflow-hidden relative min-h-32 mb-4">
		<div class="card-base z-10 px-6 md:px-9 py-6 relative w-full">
			<div class="onload-animation">
				<div class="text-3xl md:text-[2.25rem]/[2.75rem] font-bold text-black/90 dark:text-white/90 mb-3
					md:before:w-1 before:h-5 before:rounded-md before:bg-[var(--primary)]
					before:absolute before:top-[0.75rem] before:left-[-1.125rem] before:relative">
					作品集
				</div>
				<p class="text-black/50 dark:text-white/50 mb-2">
					我独立负责过什么 · 我做出过什么结果 · 我有什么别人没有的资源。
				</p>
				<p class="text-sm text-black/40 dark:text-white/40">
					每个项目按「复盘七问」展开：做了多深 / 为什么做 / 我负责什么 / 为何这么选 / 结果 / 重来怎么改 / 收获。持续更新中。
				</p>
				<div class="flex flex-wrap gap-2 mt-4">
					{entries.map((e) => (
						<a href={`/portfolio/${e.slug}/`} class="rounded-lg px-3 py-1 text-sm bg-[var(--btn-regular-bg)] hover:bg-[var(--btn-regular-bg-hover)] text-[var(--btn-content)] transition">
							{e.data.title}
						</a>
					))}
					<a href="/archive/" class="rounded-lg px-3 py-1 text-sm bg-black/5 dark:bg-white/10 hover:bg-black/10 dark:hover:bg-white/20 text-black/50 dark:text-white/50 transition">
						全部文章 →
					</a>
				</div>
			</div>
		</div>
	</div>

	<div class="grid grid-cols-1 md:grid-cols-2 gap-4">
		{entries.map((e, i) => (
			<a href={`/portfolio/${e.slug}/`} class="card-base rounded-[var(--radius-large)] px-5 py-4 hover:translate-y-[-2px] transition active:scale-[0.98] block onload-animation" style={`animation-delay: ${i * 0.05}s`}>
				<div class="flex items-center gap-2 mb-1 flex-wrap">
					<span class="text-xs rounded-md px-2 py-0.5 bg-[var(--primary)]/10 text-[var(--primary)] font-bold">{e.data.status}</span>
					{e.data.tags.map((t) => (
						<span class="text-xs text-black/40 dark:text-white/40">#{t}</span>
					))}
				</div>
				<div class="font-bold text-lg text-black/80 dark:text-white/80 mb-1">{e.data.title}</div>
				{e.data.oneLiner && (
					<div class="text-sm text-black/50 dark:text-white/50 line-clamp-2 mb-2">{e.data.oneLiner}</div>
				)}
				<div class="flex items-center gap-3 text-xs text-black/40 dark:text-white/40">
					{e.data.role && <span>{e.data.role}</span>}
					{e.data.period && <span>{e.data.period}</span>}
				</div>
			</a>
		))}
	</div>
</MainGridLayout>
